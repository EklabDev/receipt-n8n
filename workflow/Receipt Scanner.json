      "parameters": {
        "jsCode": "// Merge Google Drive link into the response\nconst formatData = $('Format Data').first().json;\nconst driveResult = $('Google Drive - Upload Image').first().json;\nconst sheetsResult = $('Google Sheets - Append Row').first().json;\n\nconst driveLink = driveResult.webViewLink || driveResult.webContentLink || '';\n\nreturn [\n  {\n    json: {\n      success: true,\n      data: {\n        ...formatData.extractedData,\n        driveLink: driveLink,\n        sheetRow: sheetsResult.updates?.updatedRows || null\n      }\n    }\n  }\n];"
