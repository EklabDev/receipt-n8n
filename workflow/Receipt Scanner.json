    {
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "text": "You are a receipt analysis assistant. Analyze the receipt image and extract the following information:\n\n1. vendor_name: The store/business name\n2. date: Transaction date in ISO 8601 format (YYYY-MM-DD)\n3. total: Total amount paid (number only, no currency symbol)\n4. tax: Tax amount (number, 0 if not visible)\n5. currency: Currency code (e.g., CAD, USD)\n6. category: Best-fit category from: [\"Office Supplies\", \"Travel\", \"Meals & Entertainment\", \"Software & Subscriptions\", \"Hardware & Equipment\", \"Professional Services\", \"Utilities\", \"Transportation\", \"Other\"]\n7. items: Array of objects with {description, amount, quantity}\n8. confidence: Your confidence level from 0.0 to 1.0\n\nReturn ONLY valid JSON with these exact field names. If a field cannot be determined, use null for strings and 0 for numbers.",
        "inputType": "base64",
        "binaryPropertyName": "image",
        "options": {}
      },
      "id": "0d313097-6e27-4884-96cb-63b0c16900b7",
      "name": "OpenAI - Analyze Receipt",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        -512,
        0
      ],
      "credentials": {
        "openAiApi": {
          "id": "B3kN1v1cXyyY0yhI",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the OpenAI response and format for Google Sheets + Drive\nconst openAiResponse = $input.first().json;\nlet parsed;\n\ntry {\n  // The response might be in message.content or directly in the output\n  const content = openAiResponse.content || openAiResponse.text || JSON.stringify(openAiResponse);\n  \n  // Extract JSON from potential markdown code blocks\n  const jsonMatch = content.match(/```json?\\n?([\\s\\S]*?)\\n?```/) || [null, content];\n  parsed = JSON.parse(jsonMatch[1].trim());\n} catch (e) {\n  throw new Error(`Failed to parse OpenAI response: ${e.message}`);\n}\n\n// Build items summary string for the sheet\nconst itemsSummary = (parsed.items || [])\n  .map(item => {\n    const qty = item.quantity && item.quantity > 1 ? `${item.quantity}× ` : '';\n    return `${qty}${item.description}: $${item.amount}`;\n  })\n  .join('; ');\n\n// Generate Drive filename\nconst vendor = (parsed.vendor_name || 'unknown').replace(/[^a-zA-Z0-9]/g, '_');\nconst date = parsed.date || new Date().toISOString().split('T')[0];\nconst filename = `receipt_${vendor}_${date}_${Date.now()}.jpg`;\n\nreturn [\n  {\n    json: {\n      // For Google Sheets\n      sheetData: {\n        date: parsed.date,\n        vendor: parsed.vendor_name,\n        category: parsed.category,\n        total: parsed.total,\n        tax: parsed.tax,\n        currency: parsed.currency,\n        items: itemsSummary,\n        confidence: parsed.confidence,\n        submittedAt: new Date().toISOString()\n      },\n      // For Google Drive\n      driveFilename: filename,\n      // For response\n      extractedData: {\n        vendor: parsed.vendor_name,\n        date: parsed.date,\n        total: parsed.total,\n        tax: parsed.tax,\n        currency: parsed.currency,\n        category: parsed.category,\n        items: parsed.items || [],\n        confidence: parsed.confidence\n      }\n    },\n    // Pass through the binary data for Drive upload\n  }\n];"
      },
