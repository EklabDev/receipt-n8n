{
  "name": "Receipt Scanner",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "receipt",
        "responseMode": "lastNode",
        "options": {
          "rawBody": false
        }
      },
      "id": "webhook-trigger",
      "name": "Webhook - Receive Receipt",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "receipt-scanner-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "api-key-check",
              "leftValue": "={{ $request.headers['x-api-key'] }}",
              "rightValue": "={{ $env.RECEIPT_API_KEY }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-auth",
      "name": "Check API Key",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: 'Unauthorized' }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "respond-401",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 480]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list",
          "cachedResultName": "gpt-4o"
        },
        "messages": {
          "values": [
            {
              "content": "You are a receipt analysis assistant. Analyze the receipt image and extract the following information:\n\n1. vendor_name: The store/business name\n2. date: Transaction date in ISO 8601 format (YYYY-MM-DD)\n3. total: Total amount paid (number only, no currency symbol)\n4. tax: Tax amount (number, 0 if not visible)\n5. currency: Currency code (e.g., CAD, USD)\n6. category: Best-fit category from: [\"Office Supplies\", \"Travel\", \"Meals & Entertainment\", \"Software & Subscriptions\", \"Hardware & Equipment\", \"Professional Services\", \"Utilities\", \"Transportation\", \"Other\"]\n7. items: Array of objects with {description, amount, quantity}\n8. confidence: Your confidence level from 0.0 to 1.0\n\nReturn ONLY valid JSON with these exact field names. If a field cannot be determined, use null for strings and 0 for numbers.",
              "role": "system"
            },
            {
              "content": "Please analyze this receipt image and extract all relevant information.",
              "role": "user"
            }
          ]
        },
        "options": {
          "temperature": 0.1,
          "maxTokens": 2000
        }
      },
      "id": "openai-vision",
      "name": "OpenAI - Analyze Receipt",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [680, 300],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the OpenAI response and format for Google Sheets + Drive\nconst openAiResponse = $input.first().json;\nlet parsed;\n\ntry {\n  // The response might be in message.content or directly in the output\n  const content = openAiResponse.message?.content || openAiResponse.text || JSON.stringify(openAiResponse);\n  \n  // Extract JSON from potential markdown code blocks\n  const jsonMatch = content.match(/```json?\\n?([\\s\\S]*?)\\n?```/) || [null, content];\n  parsed = JSON.parse(jsonMatch[1].trim());\n} catch (e) {\n  throw new Error(`Failed to parse OpenAI response: ${e.message}`);\n}\n\n// Build items summary string for the sheet\nconst itemsSummary = (parsed.items || [])\n  .map(item => {\n    const qty = item.quantity && item.quantity > 1 ? `${item.quantity}× ` : '';\n    return `${qty}${item.description}: $${item.amount}`;\n  })\n  .join('; ');\n\n// Generate Drive filename\nconst vendor = (parsed.vendor_name || 'unknown').replace(/[^a-zA-Z0-9]/g, '_');\nconst date = parsed.date || new Date().toISOString().split('T')[0];\nconst filename = `receipt_${vendor}_${date}_${Date.now()}.jpg`;\n\nreturn [\n  {\n    json: {\n      // For Google Sheets\n      sheetData: {\n        date: parsed.date,\n        vendor: parsed.vendor_name,\n        category: parsed.category,\n        total: parsed.total,\n        tax: parsed.tax,\n        currency: parsed.currency,\n        items: itemsSummary,\n        confidence: parsed.confidence,\n        submittedAt: new Date().toISOString()\n      },\n      // For Google Drive\n      driveFilename: filename,\n      // For response\n      extractedData: {\n        vendor: parsed.vendor_name,\n        date: parsed.date,\n        total: parsed.total,\n        tax: parsed.tax,\n        currency: parsed.currency,\n        category: parsed.category,\n        items: parsed.items || [],\n        confidence: parsed.confidence\n      }\n    },\n    // Pass through the binary data for Drive upload\n    binary: $input.first().binary\n  }\n];"
      },
      "id": "format-data",
      "name": "Format Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "list",
          "cachedResultName": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $json.sheetData.date }}",
            "Vendor": "={{ $json.sheetData.vendor }}",
            "Category": "={{ $json.sheetData.category }}",
            "Total": "={{ $json.sheetData.total }}",
            "Tax": "={{ $json.sheetData.tax }}",
            "Currency": "={{ $json.sheetData.currency }}",
            "Items": "={{ $json.sheetData.items }}",
            "Image Link": "={{ $json.driveLink || '' }}",
            "Confidence": "={{ $json.sheetData.confidence }}",
            "Submitted At": "={{ $json.sheetData.submittedAt }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "Date", "displayName": "Date", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string" },
            { "id": "Vendor", "displayName": "Vendor", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string" },
            { "id": "Category", "displayName": "Category", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string" },
            { "id": "Total", "displayName": "Total", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "number" },
            { "id": "Tax", "displayName": "Tax", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "number" },
            { "id": "Currency", "displayName": "Currency", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string" },
            { "id": "Items", "displayName": "Items", "required": false, "defaultMatch": false, "canBeUsedToMatch": false, "display": true, "type": "string" },
            { "id": "Image Link", "displayName": "Image Link", "required": false, "defaultMatch": false, "canBeUsedToMatch": false, "display": true, "type": "string" },
            { "id": "Confidence", "displayName": "Confidence", "required": false, "defaultMatch": false, "canBeUsedToMatch": false, "display": true, "type": "number" },
            { "id": "Submitted At", "displayName": "Submitted At", "required": false, "defaultMatch": false, "canBeUsedToMatch": false, "display": true, "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "google-sheets",
      "name": "Google Sheets - Append Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1120, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_CREDENTIAL_ID",
          "name": "Google OAuth2"
        }
      }
    },
    {
      "parameters": {
        "operation": "upload",
        "name": "={{ $json.driveFilename }}",
        "folderId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_DRIVE_FOLDER_ID",
          "mode": "id"
        },
        "inputDataFieldName": "image",
        "options": {}
      },
      "id": "google-drive",
      "name": "Google Drive - Upload Image",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1120, 420],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "GOOGLE_CREDENTIAL_ID",
          "name": "Google OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Merge Google Drive link into the response\nconst formatData = $('Format Data').first().json;\nconst driveResult = $('Google Drive - Upload Image').first().json;\nconst sheetsResult = $('Google Sheets - Append Row').first().json;\n\nconst driveLink = driveResult.webViewLink || driveResult.webContentLink || '';\n\nreturn [\n  {\n    json: {\n      success: true,\n      data: {\n        ...formatData.extractedData,\n        driveLink: driveLink,\n        submittedAt: formatData.sheetData.submittedAt,\n        sheetRow: sheetsResult.updates?.updatedRows || null\n      }\n    }\n  }\n];"
      },
      "id": "merge-response",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-200",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1560, 300]
    }
  ],
