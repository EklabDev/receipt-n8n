        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\n\nconst submittedAt = body.submittedAt ? String(body.submittedAt).trim() : '';\nconst startTime = body.startTime ? String(body.startTime).trim() : '';\nconst endTime = body.endTime ? String(body.endTime).trim() : '';\nconst distanceKm = Number(body.distanceKm);\nconst businessPurpose = body.businessPurpose ? String(body.businessPurpose).trim() : '';\nconst trackingMode = body.trackingMode === 'Manual' ? 'Manual' : 'GPS';\n\nif (!submittedAt || !startTime || !endTime || !businessPurpose) {\n  return [{ json: { valid: false, error: 'submittedAt, startTime, endTime, and businessPurpose are required' } }];\n}\nif (!Number.isFinite(distanceKm) || distanceKm <= 0) {\n  return [{ json: { valid: false, error: 'distanceKm must be a positive number' } }];\n}\nconst MILEAGE_RATE_CAD = '0.72'\nconst rate = parseFloat(MILEAGE_RATE_CAD || '0.72');\nconst roundedKm = Math.round(distanceKm * 100) / 100;\nconst deduction = Math.round(roundedKm * rate * 100) / 100;\n\nconst startLat = body.startLat != null ? Number(body.startLat) : null;\nconst startLng = body.startLng != null ? Number(body.startLng) : null;\nconst endLat = body.endLat != null ? Number(body.endLat) : null;\nconst endLng = body.endLng != null ? Number(body.endLng) : null;\n\nfunction loc(lat, lng, text) {\n  if (text) return String(text);\n  if (lat != null && lng != null && Number.isFinite(lat) && Number.isFinite(lng)) {\n    return `${lat.toFixed(6)},${lng.toFixed(6)}`;\n  }\n  return '';\n}\n\nconst date = (endTime || submittedAt).slice(0, 10);\nconst gpsPoints = body.gpsPointCount != null ? Number(body.gpsPointCount) : '';\n\nreturn [{\n  json: {\n    valid: true,\n    sheetData: {\n      date,\n      startTime,\n      endTime,\n      startLocation: loc(startLat, startLng, body.startLocation),\n      endLocation: loc(endLat, endLng, body.endLocation),\n      distanceKm: roundedKm,\n      businessPurpose,\n      vehicle: body.vehicle ? String(body.vehicle) : '',\n      trackingMode,\n      rate,\n      deduction,\n      submittedAt,\n      gpsPoints,\n    },\n    response: {\n      distanceKm: roundedKm,\n      deduction,\n      submittedAt,\n    },\n  },\n}];"
      },
