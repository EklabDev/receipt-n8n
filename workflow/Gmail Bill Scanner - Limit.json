    {
      "parameters": {
        "jsCode": "// Drop messages already recorded by Gmail date/id (Email Timestamp column)\nconst sheetRows = $('Google Sheets - Read Timestamps').all();\nconst known = new Set(\n  sheetRows\n    .map((r) => String(r.json['Email Timestamp'] ?? r.json.emailTimestamp ?? '').trim())\n    .filter(Boolean)\n);\n\nconst items = $input.all();\nconst newMessages = [];\nlet skippedExisting = 0;\n\nfor (const item of items) {\n  const msg = item.json;\n  // Use internalDate if present, otherwise fall back to date (ISO string)\n  const emailTimestamp = String(msg.internalDate ?? msg.date ?? '').trim();\n  const messageId = msg.id ?? msg.messageId;\n\n  if (!emailTimestamp || !messageId) continue;\n\n  if (known.has(emailTimestamp)) {\n    skippedExisting++;\n    continue;\n  }\n\n  newMessages.push({ json: { messageId, internalDate: emailTimestamp, skippedExisting } });\n}\n\nif (newMessages.length === 0) {\n  return [{ json: { noNew: true, skippedExisting, toProcess: 0 } }];\n}\n\nnewMessages[0].json.skippedExisting = skippedExisting;\nreturn newMessages;"
      },
