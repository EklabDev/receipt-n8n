    {
      "parameters": {
        "jsCode": "// Parse pre-parsed Gmail JSON: prefer PDF/image attachment; else extract body text for OpenAI text path\nconst message = $input.first().json;\nconst batch = $('Split In Batches').first();\n\nconst subject = message.subject || 'Email Bill';\n// console.log($input.first())\n// console.log($input.first().binary)\nconst attachments = $input.first()?.binary?Object.values($input.first().binary).filter(e=>e.mimeType===\"application/pdf\"):[]\n console.log(attachments)\n\nfunction toBase64(content) {\n  if (Buffer.isBuffer(content)) return content.toString('base64');\n  if (content && content.type === 'Buffer' && Array.isArray(content.data)) {\n    return Buffer.from(content.data).toString('base64');\n  }\n  if (typeof content === 'string') {\n    // handle base64url just in case\n    return content.replace(/-/g, '+').replace(/_/g, '/');\n  }\n  return null;\n}\n\nlet billBinary = null;\n\n// Prefer PDF attachment\nfor (const att of attachments) {\n  const mime = att.contentType || att.mimeType || '';\n  if (mime === 'application/pdf') {\n    const data = toBase64(att.content ?? att.data);\n    if (data) {\n      billBinary = {\n        data,\n        mimeType: 'application/pdf',\n        fileExtension: 'pdf',\n        fileName: att.filename || att.fileName || 'bill.pdf',\n      };\n      break;\n    }\n  }\n}\n\n// Else fall back to image attachment\nif (!billBinary) {\n  for (const att of attachments) {\n    const mime = att.contentType || att.mimeType || '';\n    if (mime.startsWith('image/')) {\n      const data = toBase64(att.content ?? att.data);\n      if (data) {\n        const ext = mime.split('/')[1] || 'jpg';\n        billBinary = {\n          data,\n          mimeType: mime,\n          fileExtension: ext,\n          fileName: att.filename || att.fileName || `bill.${ext}`,\n        };\n        break;\n      }\n    }\n  }\n}\n\nfunction stripHtml(html) {\n  return String(html || '')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\n// No attachment found: fall back to text body (prefer plain text, else strip HTML)\nlet textBody = '';\nif (!billBinary) {\n  if (message.text) {\n    textBody = message.text;\n  } else if (message.html) {\n    textBody = stripHtml(message.html);\n  }\n}\n\nconst item = {\n  json: {\n    messageId: batch.messageId || message.id,\n    internalDate: String(batch.internalDate || message.date || ''),\n    gmailMessageId: message.id,\n    subject,\n    textOnly: attachments.length<1,\n    emailBody: textBody.slice(0, 12000),\n  },\n};\n\nif ( attachments.length>0) {\n  item.binary = { bill:  attachments[0] };\n}\n\nreturn [item];"
      },
