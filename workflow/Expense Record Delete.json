        "jsCode": "const req = $('Parse Request').first().json;\nconst submittedAt = req.submittedAt;\nconst rows = $('Google Sheets - Read Rows').all();\n\nlet rowNumber = -1;\n\nfor (let i = 0; i < rows.length; i++) {\n  const row = rows[i].json;\n  if (submittedAt && String(row['Submitted At'] ?? '').trim() === submittedAt) {\n    rowNumber = i + 2;\n    break;\n  }\n}\n\nif (rowNumber < 2) {\n  return [{ json: { found: false, error: 'Record not found in Receipts tab' } }];\n}\n\nreturn [{ json: { found: true, rowNumber, matchedBy: 'Submitted At', submittedAt } }];"
