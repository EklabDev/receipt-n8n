# PIN to unlock the app (digits only)
VITE_APP_PIN=1234

# n8n webhook URL for receipt processing
VITE_N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/receipt

# Gmail bill scanner webhooks (Purchases category)
VITE_N8N_GMAIL_LIMIT_WEBHOOK_URL=https://your-n8n.example.com/webhook/gmail-bills/limit
VITE_N8N_GMAIL_ALL_WEBHOOK_URL=https://your-n8n.example.com/webhook/gmail-bills/all

# Delete records from Google Sheet tabs
VITE_N8N_DELETE_WEBHOOK_URL=https://your-n8n.example.com/webhook/expense/delete
VITE_N8N_EMAIL_DELETE_WEBHOOK_URL=https://your-n8n.example.com/webhook/email/delete

# Business mileage GPS tracking
VITE_N8N_MILEAGE_WEBHOOK_URL=https://your-n8n.example.com/webhook/mileage/trip
VITE_N8N_MILEAGE_DELETE_WEBHOOK_URL=https://your-n8n.example.com/webhook/mileage/delete

# List records from Google Sheets (Receipt Getter workflow)
VITE_N8N_RECORDS_LIST_WEBHOOK_URL=https://your-n8n.example.com/webhook/records/list

# API key for authenticating with n8n webhook
VITE_N8N_API_KEY=your-api-key-here
