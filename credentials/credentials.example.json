{
  "_comment": "This is a TEMPLATE showing credential structure. No actual secrets are stored here.",
  "credentials": [
    {
      "name": "OpenAI API",
      "type": "openAiApi",
      "data": {
        "apiKey": "<YOUR_OPENAI_API_KEY>"
      }
    },
    {
      "name": "Google OAuth2",
      "type": "googleOAuth2Api",
      "data": {
        "clientId": "<YOUR_GOOGLE_CLIENT_ID>",
        "clientSecret": "<YOUR_GOOGLE_CLIENT_SECRET>",
        "scopes": [
          "https://www.googleapis.com/auth/spreadsheets",
          "https://www.googleapis.com/auth/drive.file"
        ]
      }
    },
    {
      "name": "Google Service Account - Gmail",
      "type": "googleApi",
      "data": {
        "email": "<SERVICE_ACCOUNT_EMAIL>@<PROJECT_ID>.iam.gserviceaccount.com",
        "privateKey": "<PEM_PRIVATE_KEY_FROM_JSON_KEY_FILE>",
        "delegatedEmail": "<GMAIL_DELEGATED_USER@yourdomain.com>",
        "inpersonate": true,
        "httpNode": true,
        "scopes": [
          "https://www.googleapis.com/auth/gmail.readonly"
        ]
      },
      "_setupNote": "Upload the real JSON key via n8n UI. Set delegated user to GMAIL_DELEGATED_USER env var. Never commit the key file."
    },
    {
      "name": "Header Auth account",
      "type": "httpHeaderAuth",
      "data": {
        "name": "x-api-key",
        "value": "<SAME_AS_RECEIPT_API_KEY>"
      }
    }
  ],
  "environmentVariables": {
    "RECEIPT_API_KEY": "<GENERATE_WITH: openssl rand -hex 32>",
    "GMAIL_DELEGATED_USER": "<you@yourdomain.com>"
  }
}
